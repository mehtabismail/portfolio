# Copy this file to `.env` in the same folder and fill in values.
# `.env` is gitignored — do not commit secrets. Use the same variable NAMES on Vercel
# (Settings → Environment Variables); paste values there (not the file).
#
# Vercel: if the repo root is the parent folder, set Root Directory to `portfolio-next`.

# --- App / content ---
# static = local data in /data | dynamic = Firestore
NEXT_PUBLIC_CONTENT_MODE=dynamic
NEXT_PUBLIC_DYNAMIC_FALLBACK_TO_STATIC=true
CONTENT_REVALIDATE_SECONDS=60

# --- Firebase Admin (server only; from service account JSON) ---
FIREBASE_PROJECT_ID=dynamic-portfolio
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Cloudinary (local/CI scripts only; optional for `next dev` / Vercel runtime) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=dynamic-portfolio
